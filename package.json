{
  "name": "telestrator",
  "version": "1.0.0",
  "description": "Telestrator overlay system for ATEM switcher",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.jomboymedia.telestrator",
    "productName": "Telestrator",
    "files": [
      "main.js",
      "server.js",
      "public/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Telestrator needs camera access to read the capture card feed from the ATEM switcher.",
        "NSMicrophoneUsageDescription": "Telestrator does not record audio; this is required alongside camera access."
      }
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true
  }
}
